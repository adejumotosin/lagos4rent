{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/listings", "destination": "/listings.html" },
    { "source": "/listings/:slug", "destination": "/property.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/listings", "destination": "/admin/listings.html" },
    { "source": "/admin/listing", "destination": "/admin/listing.html" },
    { "source": "/admin/enquiries", "destination": "/admin/enquiries.html" }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

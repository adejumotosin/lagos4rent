{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/listings", "destination": "/listings.html" },
    { "source": "/listings/:slug", "destination": "/api/property?slug=:slug" },
    { "source": "/agents", "destination": "/agents.html" },
    { "source": "/agents/:id", "destination": "/agent.html" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/safety", "destination": "/safety.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/listings", "destination": "/admin/listings.html" },
    { "source": "/admin/listing", "destination": "/admin/listing.html" },
    { "source": "/admin/enquiries", "destination": "/admin/enquiries.html" },
    { "source": "/admin/trust", "destination": "/admin/trust.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://xpjdthhyfezdyhlzycin.supabase.co; media-src 'self' blob: https://xpjdthhyfezdyhlzycin.supabase.co; connect-src 'self' https://xpjdthhyfezdyhlzycin.supabase.co wss://xpjdthhyfezdyhlzycin.supabase.co; font-src 'self' data:; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
